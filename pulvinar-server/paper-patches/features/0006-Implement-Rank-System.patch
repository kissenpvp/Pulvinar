+    private Repository<String, Rank> rankRepository;
 
     public PulvinarCore(@NonNull File optionsFile) throws IOException, InvalidConfigurationException, SQLException {
         config = new PulvinarConfig();
@@ -86,6 +91,7 @@ public class PulvinarCore extends KissenCore implements Pulvinar
         operatorRepository = new PulvinarOperatorRepository(privateDatasource);
         whiteListRepository = new PulvinarWhiteListRepository(privateDatasource);
         playerRepository = new PulvinarPlayerRepository(globalDatasource);
+        rankRepository = new InternalRankRepository(globalDatasource);
     }
 
     public void shutdown()
@@ -123,4 +129,9 @@ public class PulvinarCore extends KissenCore implements Pulvinar
     public PlayerRepository playerRepository() {
         return playerRepository;
     }
+
+    @Override
+    public Repository<String, Rank> rankRepository() {
+        return rankRepository;
+    }
 }
