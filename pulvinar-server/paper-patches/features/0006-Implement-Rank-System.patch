 import net.kissenpvp.network.actor.whitelist.PulvinarWhiteListRepository;
 import org.bukkit.Bukkit;
 import org.bukkit.configuration.InvalidConfigurationException;
@@ -36,6 +39,7 @@ public class PulvinarCore extends KissenCore implements Pulvinar
     private PulvinarOperatorRepository operatorRepository;
     private PulvinarWhiteListRepository whiteListRepository;
     private PlayerRepository playerRepository;
+    private Repository<String, Rank> rankRepository;
 
     public PulvinarCore(@NonNull File optionsFile) throws IOException, InvalidConfigurationException, SQLException {
         config = new PulvinarConfig();
@@ -86,6 +90,7 @@ public class PulvinarCore extends KissenCore implements Pulvinar
         operatorRepository = new PulvinarOperatorRepository(privateDatasource);
         whiteListRepository = new PulvinarWhiteListRepository(privateDatasource);
         playerRepository = new PulvinarPlayerRepository(globalDatasource);
+        rankRepository = new InternalRankRepository(globalDatasource);
     }
 
     public void shutdown()
@@ -123,4 +128,9 @@ public class PulvinarCore extends KissenCore implements Pulvinar
     public @NonNull PlayerRepository playerRepository() {
         return playerRepository;
     }
+
+    @Override
+    public @NonNull Repository<String, Rank> rankRepository() {
+        return rankRepository;
+    }
 }
