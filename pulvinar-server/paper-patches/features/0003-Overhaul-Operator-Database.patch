index 0000000000000000000000000000000000000000..29118b4a2920fa47eb7829692fce37667e8e7fb2
--- /dev/null
+++ b/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorRepository.java
@@ -0,0 +1,30 @@
+package net.kissenpvp.network.actor.operator;
+
+import net.kissenpvp.api.network.actor.OperatorInfo;
+import net.kissenpvp.network.actor.InternalOperatorRepository;
+import net.minecraft.server.players.NameAndId;
+import net.minecraft.server.players.ServerOpListEntry;
+import org.jspecify.annotations.NonNull;
+
+import javax.sql.DataSource;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.UUID;
+
+public class PulvinarOperatorRepository extends InternalOperatorRepository
+{
+    public PulvinarOperatorRepository(@NonNull DataSource dataSource) throws NullPointerException
+    {
+        super(dataSource);
+    }
+
+    @Override
+    public @NonNull OperatorInfo toEntity(@NonNull UUID uuid, @NonNull ResultSet resultSet) throws SQLException, NullPointerException
+    {
+        NameAndId profile = new NameAndId(uuid, resultSet.getString("username"));
+        int level = resultSet.getInt("operator_level");
+        boolean canBypass = resultSet.getBoolean("can_bypass_player_limit");
+
+        return new ServerOpListEntry(profile, level, canBypass);
+    }
+}
