@@ -0,0 +1,53 @@
+package net.kissenpvp.network.actor.operator;
+
+import net.kissenpvp.api.database.Repository;
+import net.kissenpvp.api.network.actor.OperatorInfo;
+import net.minecraft.server.notifications.NotificationService;
+import net.minecraft.server.players.ServerOpList;
+import net.minecraft.server.players.ServerOpListEntry;
+import org.jspecify.annotations.NonNull;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.util.Collection;
+import java.util.Objects;
+import java.util.UUID;
+
+public class PulvinarOperatorList extends ServerOpList
+{
+    private static final Logger log = LoggerFactory.getLogger(PulvinarOperatorList.class);
+    private final Repository<UUID, OperatorInfo> repository;
+
+    public PulvinarOperatorList(@NonNull Repository<UUID, OperatorInfo> repository, NotificationService notificationService)
+    {
+        super(null, notificationService);
+        this.repository = repository;
+    }
+
+    @Override
+    public void load() throws IOException {
+        Collection<OperatorInfo> operators = repository.findAll().join();
+
+        for(OperatorInfo operator : operators)
+        {
+            ServerOpListEntry entry = (ServerOpListEntry) operator;
+            if(Objects.isNull(entry.getUser()))
+            {
+                log.warn("Discarding operator entry {} due to missing user.", operator);
+                continue;
+            }
+
+            String key = getKeyForUser(entry.getUser());
+            getMap().put(key, entry);
+        }
+    }
+
+    @Override
+    public void save() throws IOException {
+        Collection<? extends OperatorInfo> ops = getMap().values();
+
+        //noinspection unchecked
+        repository.saveAll((Iterable<OperatorInfo>) ops); // look. I know this is stupid. But just accept that this is java
+    }
+}
diff --git a/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorRepository.java b/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorRepository.java
