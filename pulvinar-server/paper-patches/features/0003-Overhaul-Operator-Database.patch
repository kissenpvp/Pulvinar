@@ -0,0 +1,43 @@
+package net.kissenpvp.network.actor.operator;
+
+import net.kissenpvp.api.database.PersistableEntity;
+import net.minecraft.server.permissions.LevelBasedPermissionSet;
+import net.minecraft.server.players.NameAndId;
+import org.jspecify.annotations.NonNull;
+import org.jspecify.annotations.Nullable;
+
+import java.util.UUID;
+
+/**
+ * Represents operator information stored in and retrieved from the database.
+ *
+ * <p>
+ * This interface defines the persistent data associated with an operator and
+ * serves as a bridge between the persistence layer and the operator entries.
+ *
+ * @author Ivo Quiring
+ */
+public interface PulvinarOperatorInfo extends PersistableEntity<UUID> {
+
+    /**
+     * Returns the user that may be acting as an operator in the current context.
+     *
+     * @return the operator user, can be {@code null}
+     */
+    @Nullable NameAndId getUser();
+
+    /**
+     * Returns the permission set associated with this operator.
+     *
+     * @return the configured permission set; never {@code null}
+     */
+    @NonNull LevelBasedPermissionSet permissions();
+
+    /**
+     * Determines whether the configured player limit should be ignored by this operator.
+     *
+     * @return {@code true} if players are allowed to join regardless of the player limit;
+     *         {@code false} if the limit is enforced
+     */
+    boolean getBypassesPlayerLimit();
+}
diff --git a/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorList.java b/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorList.java
new file mode 100644
index 0000000000000000000000000000000000000000..3d9a102b79ddcfb14988e207d2775076a1fbb6a6
--- /dev/null
+++ b/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorList.java
@@ -0,0 +1,57 @@
+package net.kissenpvp.network.actor.operator;
+
+import net.kissenpvp.api.database.Repository;
+import net.minecraft.server.notifications.NotificationService;
+import net.minecraft.server.players.ServerOpList;
+import net.minecraft.server.players.ServerOpListEntry;
+import org.jspecify.annotations.NonNull;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Collection;
+import java.util.Objects;
+import java.util.UUID;
+
+public class PulvinarOperatorList extends ServerOpList
+{
+    private static final Logger log = LoggerFactory.getLogger(PulvinarOperatorList.class);
+    private final Repository<UUID, PulvinarOperatorInfo> repository;
+
+    public PulvinarOperatorList(@NonNull File file, @NonNull Repository<UUID, PulvinarOperatorInfo> repository, NotificationService notificationService)
+    {
+        super(file, notificationService);
+        this.repository = repository;
+    }
+
+    @Override
+    public void load() throws IOException {
+        Collection<PulvinarOperatorInfo> operators = repository().findAll().join();
+
+        for(PulvinarOperatorInfo operator : operators)
+        {
+            ServerOpListEntry entry = (ServerOpListEntry) operator;
+            if(Objects.isNull(entry.getUser()))
+            {
+                log.warn("Discarding operator entry {} due to missing user.", operator);
+                continue;
+            }
+
+            String key = getKeyForUser(entry.getUser());
+            getMap().put(key, entry);
+        }
+    }
+
+    @Override
+    public void save() throws IOException {
+        Collection<? extends PulvinarOperatorInfo> ops = getMap().values();
+
+        //noinspection unchecked
+        repository().saveAll((Iterable<PulvinarOperatorInfo>) ops); // look. I know this is stupid. But just accept that this is java
+    }
+
+    public @NonNull Repository<UUID, PulvinarOperatorInfo> repository() {
+        return repository;
+    }
+}
diff --git a/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorRepository.java b/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorRepository.java
new file mode 100644
index 0000000000000000000000000000000000000000..79d4b3015276c9c986c65d3a52b4ba7953b3e48c
--- /dev/null
+++ b/src/main/java/net/kissenpvp/network/actor/operator/PulvinarOperatorRepository.java
@@ -0,0 +1,166 @@
+package net.kissenpvp.network.actor.operator;
+
+import com.google.common.base.Preconditions;
+import net.kissenpvp.api.database.DeletableRepository;
+import net.kissenpvp.api.database.KissenRepository;
+import net.kissenpvp.base.PulvinarCore;
+import net.kissenpvp.database.AsyncDatabaseQueue;
+import net.minecraft.server.permissions.LevelBasedPermissionSet;
+import net.minecraft.server.permissions.PermissionLevel;
+import net.minecraft.server.players.NameAndId;
+import net.minecraft.server.players.ServerOpListEntry;
+import org.bukkit.Bukkit;
+import org.jspecify.annotations.NonNull;
+
+import javax.sql.DataSource;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.*;
+import java.util.concurrent.CompletableFuture;
+
+public class PulvinarOperatorRepository extends KissenRepository<UUID, PulvinarOperatorInfo> implements DeletableRepository<UUID> {
+
+    public PulvinarOperatorRepository(@NonNull DataSource dataSource) throws NullPointerException {
+        super(dataSource);
+    }
+
+    private static @NonNull String globalDatabase() {
+        return ((PulvinarCore) Bukkit.getPulvinar()).config().databaseGlobal();
+    }
+
+    private static @NonNull PulvinarOperatorInfo toEntity(@NonNull UUID id, @NonNull ResultSet resultSet) throws SQLException {
+        Preconditions.checkNotNull(id, "Id must not be null.");
+        Preconditions.checkNotNull(resultSet, "Resultset must not be null.");
+
+        String username = resultSet.getString("username");
+
+        NameAndId identify = new NameAndId(id, username);
+        int level = resultSet.getInt("operator_level_id");
+        boolean canBypassPlayerLimit = resultSet.getBoolean("can_bypass_player_limit");
+
+        LevelBasedPermissionSet permissionSet = LevelBasedPermissionSet.forLevel(PermissionLevel.byId(level));
+        return new ServerOpListEntry(identify, permissionSet, canBypassPlayerLimit);
+    }
+
+
+    private static @NonNull Collection<PulvinarOperatorInfo> collectResults(@NonNull PreparedStatement statement) throws SQLException {
+        Preconditions.checkNotNull(statement, "statement must not be null.");
+
+        Collection<PulvinarOperatorInfo> collection = new HashSet<>();
+
+        try (ResultSet resultSet = statement.executeQuery()) {
+            while (resultSet.next()) {
+                UUID uuid = UUID.fromString(resultSet.getString("id"));
+                collection.add(toEntity(uuid, resultSet));
+            }
+        }
+
+        return Collections.unmodifiableCollection(collection);
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Optional<PulvinarOperatorInfo>> find(@NonNull UUID id) {
+        Preconditions.checkNotNull(id, "Id cannot be null.");
+
+        String sql = "SELECT o.id, p.username AS username, o.operator_level, o.can_bypass_player_limit FROM ksvp_operators o JOIN %s.ksvp_player p ON o.id = p.id WHERE o.id = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(this.query(String.format(sql, globalDatabase()), (statement) -> {
+            statement.setString(1, String.valueOf(id));
+            try (ResultSet resultSet = statement.executeQuery()) {
+                if (!resultSet.next()) {
+                    return Optional.empty();
+                }
+
+                UUID uuid = UUID.fromString(resultSet.getString("id"));
+                return Optional.of(toEntity(uuid, resultSet));
+            }
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Collection<PulvinarOperatorInfo>> findAll(@NonNull Iterable<UUID> id) {
+        Preconditions.checkNotNull(id, "Iterable cannot be null.");
+
+        String placeHolders = String.join(", ", Collections.nCopies(this.computeIterableSize(id), "?"));
+        String sql = "SELECT o.id, p.username AS username, o.operator_level_id, o.can_bypass_player_limit FROM ksvp_operators o JOIN %s.ksvp_player p ON o.id = p.id WHERE o.id IN (" + placeHolders + ");";
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(String.format(sql, globalDatabase()), (statement) -> {
+            int index = 1;
+
+            for (UUID current : id) {
+                statement.setString(index++, String.valueOf(current));
+            }
+
+            return collectResults(statement);
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Collection<PulvinarOperatorInfo>> findAll() {
+        String sql = "SELECT o.id, p.username AS username, o.operator_level_id, o.can_bypass_player_limit FROM ksvp_operators o JOIN %s.ksvp_player p ON o.id = p.id;";
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(String.format(sql, globalDatabase()), PulvinarOperatorRepository::collectResults)));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Boolean> has(@NonNull UUID id) throws NullPointerException {
+        Preconditions.checkNotNull(id, "id must not be null.");
+
+        String sql = "SELECT id FROM ksvp_operators WHERE id = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(sql, (statement) -> {
+            statement.setString(1, String.valueOf(id));
+            try (ResultSet resultSet = statement.executeQuery()) {
+                return resultSet.next();
+            }
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<Void> saveAll(@NonNull Iterable<PulvinarOperatorInfo> id) throws NullPointerException {
+        Preconditions.checkNotNull(id, "Iterable must not be null.");
+
+        return AsyncDatabaseQueue.submitTask(() -> {
+
+            // as the operators are saved at once, we must clear the list so that removed entries will not remain in the database
+            // operators will likely never exceed a low number in terms of computers, so this does not tank performance all to much
+            //noinspection SqlWithoutWhere
+            query("DELETE FROM ksvp_operators;", PreparedStatement::executeUpdate);
+
+            String sql = "INSERT INTO ksvp_operators (id, operator_level_id, can_bypass_player_limit) VALUES (?, ?, ?) ON DUPLICATE KEY UPDATE operator_level_id = ?, can_bypass_player_limit = ?;";
+            return query(sql, (statement) -> {
+
+                for (PulvinarOperatorInfo pulvinarOperatorInfo : id) {
+                    statement.setString(1, String.valueOf(pulvinarOperatorInfo.id()));
+
+                    int levelId = pulvinarOperatorInfo.permissions().level().id();
+                    statement.setInt(2, levelId);
+                    statement.setInt(4, levelId);
+
+                    statement.setBoolean(3, pulvinarOperatorInfo.getBypassesPlayerLimit());
+                    statement.setBoolean(5, pulvinarOperatorInfo.getBypassesPlayerLimit());
+                    statement.addBatch();
+                }
+
+                statement.executeBatch();
+                return null;
+            });
+        });
+    }
+
+    @Override
+    public @NonNull CompletableFuture<Void> delete(@NonNull UUID uuid) {
+        return deleteAll(Collections.singleton(uuid));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<Void> deleteAll(@NonNull Iterable<UUID> iterable) {
+        String sql = "DELETE FROM ksvp_operators WHERE id = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> query(sql, (statement) -> {
+            for(UUID id : iterable)
+            {
+                statement.setString(1, String.valueOf(id));
+                statement.addBatch();
+            }
+            statement.executeBatch();
+            return null;
+        }));
+    }
+}
