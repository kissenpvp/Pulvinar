@@ -0,0 +1,86 @@
+package net.kissenpvp.network.actor;
+
+import net.kissenpvp.api.network.actor.PlayerClient;
+import org.bukkit.Bukkit;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.jetbrains.annotations.UnmodifiableView;
+
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.*;
+import java.util.concurrent.CompletableFuture;
+
+public class PulvinarPlayerRepository extends InternalPlayerRepository {
+
+    public PulvinarPlayerRepository(@NotNull Connection connection) throws NullPointerException {
+        super(connection);
+    }
+
+    @Override
+    public @NotNull CompletableFuture<@Nullable PlayerClient> findByName(@NotNull String name, boolean utilizeCache) throws NullPointerException {
+        String sql = "SELECT * FROM %s WHERE username = ?;";
+        return CompletableFuture.supplyAsync(() -> query(sql, (statement) ->
+        {
+            statement.setString(1, name);
+
+            try(ResultSet resultSet = statement.executeQuery())
+            {
+                if(!resultSet.next())
+                {
+                    return null;
+                }
+
+                return toEntity(resultSet);
+            }
+        }));
+    }
+
+    @Override
+    public @NotNull CompletableFuture<@UnmodifiableView Collection<PlayerClient>> findAllByName(@NotNull Iterable<String> iterable, boolean utilizeCache) throws NullPointerException {
+
+        int size = 0;
+        for (Object ignored : iterable) { size++; }
+
+        if(size == 0)
+        {
+            return CompletableFuture.completedFuture(Collections.emptyList());
+        }
+
+        String dynamicPlaceholders = String.join(", ", Collections.nCopies(size, "?"));
+        String sql = "SELECT * FROM %s WHERE username IN (" + dynamicPlaceholders + ");";
+
+        return CompletableFuture.supplyAsync(() -> query(sql, (statement) ->
+        {
+            int current = 0;
+            for (String xx : iterable) {
+                statement.setString(current + 1, xx);
+                current++;
+            }
+
+            List<PlayerClient> clients = new ArrayList<>();
+            try(ResultSet resultSet = statement.executeQuery())
+            {
+                while(resultSet.next())
+                {
+                    clients.add(toEntity(resultSet));
+                }
+            }
+
+            return Collections.unmodifiableList(clients);
+        }));
+    }
+
+    @Override
+    protected @NotNull PlayerClient toCachedEntity(@NotNull UUID uuid, @NotNull ResultSet resultSet) throws SQLException, NullPointerException {
+        PlayerClient playerClient = Bukkit.getOfflinePlayer(uuid);
+        // TODO: Set data if necessary
+        return playerClient; // will automatically adapt reachable player if online
+    }
+
+    @Override
+    protected @NotNull PlayerClient toCachedEntity(@NotNull ResultSet resultSet) throws SQLException, NullPointerException {
+        return toCachedEntity(UUID.fromString(resultSet.getString("id")), resultSet);
+    }
+}
