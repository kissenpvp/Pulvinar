@@ -172,6 +172,14 @@ public class Main {
                     .describedAs("Yml file");
                 // Purpur end - Purpur config files
 
+                // Pulvinar start - Pulvinar config files
+                this.acceptsAll(asList("purpur", "pulvinar-settings"), "File for pulvinar settings")
+                        .withRequiredArg()
+                        .ofType(File.class)
+                        .defaultsTo(new File("pulvinar.yml"))
