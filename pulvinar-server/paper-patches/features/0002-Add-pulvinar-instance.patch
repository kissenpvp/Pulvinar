--- /dev/null
+++ b/src/main/java/net/kissenpvp/player/PulvinarPlayerRepository.java
@@ -0,0 +1,26 @@
+package net.kissenpvp.player;
+
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.api.network.actor.PlayerRepository;
+import net.kissenpvp.network.actor.InternalPlayerRepository;
+import net.kissenpvp.network.actor.rank.repository.InternalRankRepository;
+import org.jetbrains.annotations.NotNull;
+
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.UUID;
+
+public class PulvinarPlayerRepository extends InternalPlayerRepository implements PlayerRepository
+{
+    public PulvinarPlayerRepository(@NotNull Connection connection) throws NullPointerException
+    {
+        super(connection);
+    }
+
+    @Override
+    protected @NotNull PlayerClient toEntity(@NotNull UUID uuid, @NotNull ResultSet resultSet) throws SQLException, NullPointerException
+    {
+        return null;
+    }
+}
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java b/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
index f967560da343867fdc1c380a42874b0796633777..b54529d0efd4a989407423c6aa2b7e7dca2bb3a4 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
@@ -762,4 +762,58 @@ public class CraftOfflinePlayer implements OfflinePlayer, ConfigurationSerializa
         }
     }
     // Purpur end - OfflinePlayer API
+
+    // Pulvinar start - add player client api
+
+    @Override public @org.jetbrains.annotations.NotNull java.util.UUID linkId()
+    {
+        return getUniqueId(); // TODO - actually load the data
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull Instant lastLogin()
+    {
+        return java.time.Instant.ofEpochMilli(getLastLogin());
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull net.kissenpvp.api.temporal.timespan.DefinedTimeSpan timePlayed()
+    {
+        return null;
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull java.util.UUID id()
+    {
+        return getUniqueId();
+    }
+
+    @Override public int signature()
+    {
+        return java.util.Objects.hash(getUniqueId(), getName());
+    }
+
+    @Override public boolean unsaved()
+    {
+        return false;
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull String username()
+    {
+        String userName = getName();
+        if(java.util.Objects.isNull(userName))
+        {
+            String message = "The username of player {} is unset.";
+            throw new java.lang.NullPointerException(String.format(message, getUniqueId()));
+        }
+        return this.getName();
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull java.util.Locale locale()
+    {
+        return java.util.Locale.ENGLISH;
+    }
+
+    @Override public final boolean isClient()
+    {
+        return true;
+    }
+    // Pulvinar end - add player client api
 }
