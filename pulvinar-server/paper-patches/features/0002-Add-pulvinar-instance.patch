diff --git a/src/main/java/net/kissenpvp/player/PlayerCache.java b/src/main/java/net/kissenpvp/player/PlayerCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..011cb5a9c44b1a43432e4804f5d2af97db32bf7d
--- /dev/null
+++ b/src/main/java/net/kissenpvp/player/PlayerCache.java
@@ -0,0 +1,100 @@
+package net.kissenpvp.player;
+
+import com.destroystokyo.paper.profile.CraftPlayerProfile;
+import com.mojang.authlib.GameProfile;
+import com.mojang.authlib.GameProfileRepository;
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.api.network.actor.PlayerRepository;
+import net.minecraft.server.players.GameProfileCache;
+import org.bukkit.Bukkit;
+import org.bukkit.OfflinePlayer;
+import org.bukkit.craftbukkit.CraftServer;
+import org.jetbrains.annotations.Contract;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.function.Function;
+
+public class PlayerCache extends GameProfileCache {
+    @Contract(value = "-> new", pure = true)
+    private static @NotNull Function<PlayerClient, Optional<GameProfile>> toProfile()
+    {
+        return playerClient ->
+        {
+            if(Objects.isNull(playerClient))
+            {
+                return Optional.empty();
+            }
+            GameProfile gameProfile = new GameProfile(playerClient.id(), playerClient.username());
+            return Optional.of(gameProfile);
+        };
+    }
+
+    private static final Logger log = LoggerFactory.getLogger(PlayerCache.class);
+
+    private PlayerRepository playerRepository;
+
+    public PlayerCache(@NotNull GameProfileRepository profileRepository) {
+        super(profileRepository, null); // not file based
+    }
+
+    @Override
+    public void add(@NotNull GameProfile gameProfile) {
+        OfflinePlayer player = ((CraftServer) Bukkit.getServer()).getOfflinePlayer(gameProfile);
+        log.info("Add player {} to cache.", gameProfile);
+        playerRepository.save(player);
+    }
+
+    @Override
+    public @Nullable GameProfile getProfileIfCached(@NotNull String name) {
+        if(!playerRepository.cached(name))
+        {
+            return null;
+        }
+        PlayerClient player = playerRepository.findByName(name).join();
+
+        if(Objects.isNull(player))
+        {
+            return null;
+        }
+
+        return new GameProfile(player.id(), player.username());
+    }
+
+    @Override
+    public @NotNull Optional<GameProfile> get(@NotNull String name) {
+        return getAsync(name).join();
+    }
+
+    @Override
+    public @NotNull CompletableFuture<Optional<GameProfile>> getAsync(@NotNull String name) {
+        return playerRepository.findByName(name).thenApply(toProfile());
+    }
+
+    @Override
+    public @NotNull Optional<GameProfile> get(@NotNull UUID uuid) {
+        return playerRepository.find(uuid).thenApply(toProfile()).join();
+    }
+
+    @Override
+    public void setExecutor(@NotNull Executor exectutor) {
+        super.setExecutor(exectutor);
+    }
+
+    @Override
+    public void clearExecutor() {
+        super.clearExecutor();
+    }
+
+    @Override
+    public void save(boolean asyncSave) {
+        super.save(asyncSave);
+    }
+}
diff --git a/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java b/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
index f967560da343867fdc1c380a42874b0796633777..b54529d0efd4a989407423c6aa2b7e7dca2bb3a4 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftOfflinePlayer.java
@@ -762,4 +762,58 @@ public class CraftOfflinePlayer implements OfflinePlayer, ConfigurationSerializa
         }
     }
     // Purpur end - OfflinePlayer API
+
+    // Pulvinar start - add player client api
+
+    @Override public @org.jetbrains.annotations.NotNull java.util.UUID linkId()
+    {
+        return getUniqueId(); // TODO - actually load the data
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull Instant lastLogin()
+    {
+        return java.time.Instant.ofEpochMilli(getLastLogin());
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull net.kissenpvp.api.temporal.timespan.DefinedTimeSpan timePlayed()
+    {
+        return null;
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull java.util.UUID id()
+    {
+        return getUniqueId();
+    }
+
+    @Override public int signature()
+    {
+        return java.util.Objects.hash(getUniqueId(), getName());
+    }
+
+    @Override public boolean unsaved()
+    {
+        return false;
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull String username()
+    {
+        String userName = getName();
+        if(java.util.Objects.isNull(userName))
+        {
+            String message = "The username of player {} is unset.";
+            throw new java.lang.NullPointerException(String.format(message, getUniqueId()));
+        }
+        return this.getName();
+    }
+
+    @Override public @org.jetbrains.annotations.NotNull java.util.Locale locale()
+    {
+        return java.util.Locale.ENGLISH;
+    }
+
+    @Override public final boolean isClient()
+    {
+        return true;
+    }
+    // Pulvinar end - add player client api
 }
