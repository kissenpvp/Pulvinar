diff --git a/src/main/java/net/kissenpvp/player/PlayerCache.java b/src/main/java/net/kissenpvp/player/PlayerCache.java
new file mode 100644
index 0000000000000000000000000000000000000000..011cb5a9c44b1a43432e4804f5d2af97db32bf7d
--- /dev/null
+++ b/src/main/java/net/kissenpvp/player/PlayerCache.java
@@ -0,0 +1,100 @@
+package net.kissenpvp.player;
+
+import com.destroystokyo.paper.profile.CraftPlayerProfile;
+import com.mojang.authlib.GameProfile;
+import com.mojang.authlib.GameProfileRepository;
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.api.network.actor.PlayerRepository;
+import net.minecraft.server.players.GameProfileCache;
+import org.bukkit.Bukkit;
+import org.bukkit.OfflinePlayer;
+import org.bukkit.craftbukkit.CraftServer;
+import org.jetbrains.annotations.Contract;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.function.Function;
+
+public class PlayerCache extends GameProfileCache {
+    @Contract(value = "-> new", pure = true)
+    private static @NotNull Function<PlayerClient, Optional<GameProfile>> toProfile()
+    {
+        return playerClient ->
+        {
+            if(Objects.isNull(playerClient))
+            {
+                return Optional.empty();
+            }
+            GameProfile gameProfile = new GameProfile(playerClient.id(), playerClient.username());
+            return Optional.of(gameProfile);
+        };
+    }
+
+    private static final Logger log = LoggerFactory.getLogger(PlayerCache.class);
+
+    private PlayerRepository playerRepository;
+
+    public PlayerCache(@NotNull GameProfileRepository profileRepository) {
+        super(profileRepository, null); // not file based
+    }
+
+    @Override
+    public void add(@NotNull GameProfile gameProfile) {
+        OfflinePlayer player = ((CraftServer) Bukkit.getServer()).getOfflinePlayer(gameProfile);
+        log.info("Add player {} to cache.", gameProfile);
+        playerRepository.save(player);
+    }
+
+    @Override
+    public @Nullable GameProfile getProfileIfCached(@NotNull String name) {
+        if(!playerRepository.cached(name))
+        {
+            return null;
+        }
+        PlayerClient player = playerRepository.findByName(name).join();
+
+        if(Objects.isNull(player))
+        {
+            return null;
+        }
+
+        return new GameProfile(player.id(), player.username());
+    }
+
+    @Override
+    public @NotNull Optional<GameProfile> get(@NotNull String name) {
+        return getAsync(name).join();
+    }
+
+    @Override
+    public @NotNull CompletableFuture<Optional<GameProfile>> getAsync(@NotNull String name) {
+        return playerRepository.findByName(name).thenApply(toProfile());
+    }
+
+    @Override
+    public @NotNull Optional<GameProfile> get(@NotNull UUID uuid) {
+        return playerRepository.find(uuid).thenApply(toProfile()).join();
+    }
+
+    @Override
+    public void setExecutor(@NotNull Executor exectutor) {
+        super.setExecutor(exectutor);
+    }
+
+    @Override
+    public void clearExecutor() {
+        super.clearExecutor();
+    }
+
+    @Override
+    public void save(boolean asyncSave) {
+        super.save(asyncSave);
+    }
+}
diff --git a/src/main/java/net/kissenpvp/player/PulvinarPlayerRepository.java b/src/main/java/net/kissenpvp/player/PulvinarPlayerRepository.java
new file mode 100644
index 0000000000000000000000000000000000000000..b0b6ae4403013c8abc6101a355ecdbd27932cc4f
--- /dev/null
+++ b/src/main/java/net/kissenpvp/player/PulvinarPlayerRepository.java
@@ -0,0 +1,119 @@
+package net.kissenpvp.player;
+
+import com.destroystokyo.paper.profile.PaperGameProfileRepository;
+import com.mojang.authlib.GameProfile;
+import com.mojang.authlib.GameProfileRepository;
+import com.mojang.authlib.ProfileLookupCallback;
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.api.network.actor.PlayerRepository;
+import net.kissenpvp.network.actor.InternalPlayerRepository;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.UnmodifiableView;
+
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.*;
+
+public class PulvinarPlayerRepository extends InternalPlayerRepository implements PlayerRepository, GameProfileRepository
+{
+    private PaperGameProfileRepository parent;
+
+    public PulvinarPlayerRepository(@NotNull Connection connection, @NotNull PaperGameProfileRepository parent) throws NullPointerException
+    {
+        super(connection);
+        this.parent = parent;
+    }
+
+    @Override
+    protected @NotNull PlayerClient toEntity(@NotNull UUID uuid, @NotNull ResultSet resultSet) throws SQLException, NullPointerException
+    {
+        return null;
+    }
+
+    @Override
+    public void findProfilesByNames(@NotNull String[] names, @NotNull ProfileLookupCallback callback) {
+
+        // first check for plugin event gameprofiles
+        Set<String> remaining = parent.lookupProfileEvent(names, callback);
+
+        // then check the database
+        String[] remainingArr = remaining.toArray(new String[0]);
+        remainingArr = findByName(remainingArr, callback).toArray(new String[0]);
+
+        // last search the mojang api
+        parent.findProfilesByNameDirectly(remainingArr, callback);
+    }
+
+    @Override
+    public Optional<@NotNull GameProfile> findProfileByName(@NotNull String name) {
+        return findByName(name).or(() -> parent.findProfileByName(name));
+    }
+
+    /**
+     * Searches for a game profile by the specified username in the repository.
+     *
+     * @param name the username of the game profile to search for, must not be null
+     * @return an {@code Optional} containing the corresponding {@code GameProfile} if found,
+     * or an empty {@code Optional} if not found
+     */
+    private @NotNull Optional<GameProfile> findByName(@NotNull String name)
+    {
+        return query("SELECT id FROM %s WHERE username = ?;", (statement) -> {
+
+            GameProfile gameProfile = null;
+
+            statement.setString(1, name);
+            try (ResultSet resultSet = statement.executeQuery())
+            {
+                if(resultSet.next())
+                {
+                    UUID uuid = UUID.fromString(resultSet.getString("id"));
+                    gameProfile = new GameProfile(uuid, name);
+                }
+            }
+
+            statement.close();
+            return Optional.ofNullable(gameProfile);
+        });
+    }
+
+    /**
+     * Finds game profile names that are not in the provided repository by performing a lookup using the
+     * specified array of names. The method interacts with the database to search for profiles and uses
+     * a callback to handle the result for found profiles.
+     *
+     * @param names an array of usernames to search for must not be null
+     * @param profileLookupCallback a callback to handle the lookup results for profiles must not be null
+     * @return an unmodifiable set of usernames that were not found in the database
+     */
+    private @NotNull @UnmodifiableView Set<String> findByName(@NotNull String[] names, @NotNull ProfileLookupCallback profileLookupCallback)
+    {
+        String data = String.join(", ", Collections.nCopies(names.length, "?"));
+        return query("SELECT id, username FROM %s WHERE username IN (" + data + ");", (statement) -> {
+
+            for (int i = 0; i < names.length; i++) {
+                statement.setString(i + 1, names[i]);
+            }
+
+            Set<String> found = new HashSet<>();
+
+            try (ResultSet resultSet = statement.executeQuery()) {
+                while (resultSet.next()) {
+                    UUID uuid = UUID.fromString(resultSet.getString("id"));
+                    String username = resultSet.getString("username");
+
+                    profileLookupCallback.onProfileLookupSucceeded(new GameProfile(uuid, username));
+
+                    found.add(username);
+                }
+            }
+
+            statement.close();
+
+            Set<String> remaining = new HashSet<>(Set.of(names));
+            remaining.removeAll(found);
+            return Collections.unmodifiableSet(remaining);
+        });
+    }
+}
