--- /dev/null
+++ b/src/main/java/net/kissenpvp/base/PulvinarCore.java
@@ -0,0 +1,80 @@
+package net.kissenpvp.base;
+
+import net.kissenpvp.api.database.ConnectionProvider;
+import net.kissenpvp.api.network.actor.PlayerModule;
+import net.kissenpvp.api.network.actor.rank.RankModule;
+import net.kissenpvp.api.punishment.PunishmentModule;
+import net.kissenpvp.database.InternalConnectionProvider;
+import net.kissenpvp.network.actor.InternalPlayerModule;
+import net.kissenpvp.network.actor.PulvinarPlayerRepository;
+import net.kissenpvp.network.actor.rank.InternalRankModule;
+import net.kissenpvp.network.actor.rank.repository.InternalRankRepository;
+import net.kissenpvp.network.actor.rank.repository.InternalRankSubscriptionRepository;
+import net.kissenpvp.punishment.InternalPunishmentModule;
+import net.kissenpvp.punishment.repository.PunishmentRepository;
+import net.kissenpvp.punishment.repository.PunishmentSubscriptionRepository;
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.jetbrains.annotations.NotNull;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.File;
+import java.io.IOException;
+import java.sql.Connection;
+import java.sql.SQLException;
+
+/**
+ * Allows access to the kissen api
+ */
+public class PulvinarCore extends KissenCore implements Pulvinar
+{
+    private static final Logger log = LoggerFactory.getLogger(PulvinarCore.class);
+    private PulvinarConfig config;
+
+    public PulvinarCore(@NotNull File optionsFile) throws IOException, InvalidConfigurationException, SQLException {
+        config = new PulvinarConfig();
+        config.init(optionsFile);
+
+        if(!config.databaseConfigured())
+        {
+            log.warn("*".repeat(50));
+            log.warn("The database has not yet been configured.");
+            log.warn("Please be sure to set \"database.configured\" to \"true\" after configuring.");
+            log.warn("If you need assistance with setting up the database see https://docs.pulvinar.org/TODO");
+            log.warn("*".repeat(50));
+
+            throw new IllegalStateException("Could not connect to database, please check your configuration.");
+        }
+
+        ConnectionProvider provider = new InternalConnectionProvider();
+        provider.connect(config.databaseUrl(), config.databaseUser(), config.databasePassword());
+
+        if(provider.connection().isEmpty())
+        {
+            throw new SQLException("The providers connection is not present. Couldn't it connect?");
+        }
+
+        Connection connection = provider.connection().get();
+
+        PunishmentRepository pRepository = new PunishmentRepository(connection);
+        PunishmentSubscriptionRepository psRepository = new PunishmentSubscriptionRepository(connection);
+        PunishmentModule punishmentModule = new InternalPunishmentModule(pRepository, psRepository);
+        log.debug("The punishment module has been initialized.");
+
+        InternalRankRepository rRepository = new InternalRankRepository(connection);
+        InternalRankSubscriptionRepository rsRepository = new InternalRankSubscriptionRepository(connection);
+        RankModule rankModule = new InternalRankModule(rRepository, rsRepository);
+        log.debug("The rank module has been initialized.");
+
+        PulvinarPlayerRepository playerRepository = new PulvinarPlayerRepository(connection);
+        PlayerModule playerModule = new InternalPlayerModule(playerRepository);
+        log.debug("The player module has been initialized.");
+
+        log.debug("Proceeding to populate core instance...");
+        startCore(punishmentModule, rankModule, playerModule);
+    }
+
+    public @NotNull PulvinarConfig config() {
+        return config;
+    }
+}
