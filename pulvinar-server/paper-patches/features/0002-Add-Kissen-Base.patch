diff --git a/src/main/java/net/kissenpvp/base/PulvinarConfig.java b/src/main/java/net/kissenpvp/base/PulvinarConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..80881cb8f73a6f8c40a2546b69b61ef6e463b413
--- /dev/null
+++ b/src/main/java/net/kissenpvp/base/PulvinarConfig.java
@@ -0,0 +1,105 @@
+package net.kissenpvp.base;
+
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.jspecify.annotations.NonNull;
+
+import java.io.File;
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.util.List;
+import java.util.Objects;
+
+public class PulvinarConfig {
+
+    private static final List<String> HEADER = List.of(
+            "This is the configuration file for the pulvinar server.",
+            "It is advised to read the documentation to prevent unexpected behavior.",
+            "",
+            "The documentation can be found at https://docs.pulvinar.org/",
+            "If you have any questions or found any bugs, please report them at https://github.com/kissenpvp/pulvinar/issues",
+            "You are welcomed to also join our discord server at https://discord.pulvinar.org",
+            "",
+            "Thank you for using pulvinar!"
+    );
+    private File file;
+    private YamlConfiguration config;
+
+    private int version;
+
+    private boolean databaseConfigured;
+    private String databaseUrl;
+    private String databaseUser;
+    private String databasePassword;
+
+    public void init(@NonNull File configFile) throws IOException, InvalidConfigurationException {
+        file = configFile;
+        config = new YamlConfiguration();
+
+        try {
+            config.load(configFile);
+        } catch (FileNotFoundException ignored) {}
+
+        config.options().setHeader(HEADER);
+        config.options().copyDefaults(true);
+
+        version = config.getInt("config-version");
+        config.set("config-version", 1);
+
+
+        config.addDefault("database.configured", false);
+        config.addDefault("database.url", "jdbc:mysql://<url>:<port>/<database>");
+        config.addDefault("database.user", "user");
+        config.addDefault("database.password", "password");
+
+        databaseConfigured = config.getBoolean("database.configured");
+        databaseUrl = config.getString("database.url");
+        databaseUser = config.getString("database.user");
+        databasePassword = config.getString("database.password");
+
+        config.save(file);
+    }
+
+    public int version() {
+        return version;
+    }
+
+    public boolean databaseConfigured() {
+        return databaseConfigured;
+    }
+
+    public @NonNull String databaseUrl() {
+        return databaseUrl;
+    }
+
+    public @NonNull String databaseUser() {
+        return databaseUser;
+    }
+
+    public @NonNull String databasePassword() {
+        return databasePassword;
+    }
+
+    public void databaseConfigured(boolean configured) throws IOException {
+        databaseConfigured = configured;
+        config.save(file);
+    }
+
+    public void databaseUrl(@NonNull String url) throws IOException, NullPointerException {
+        Objects.requireNonNull(url, "url cannot be null");
+        databaseUrl = url;
+        config.save(file);
+    }
+
+    public void databaseUser(@NonNull String user) throws IOException, NullPointerException {
+        Objects.requireNonNull(user, "user cannot be null");
+        databaseUser = user;
+        config.save(file);
+    }
+
+    public void databasePassword(@NonNull String password) throws IOException, NullPointerException {
+        Objects.requireNonNull(password, "password cannot be null");
+        databasePassword = password;
+        config.save(file);
+    }
+}
diff --git a/src/main/java/net/kissenpvp/base/PulvinarCore.java b/src/main/java/net/kissenpvp/base/PulvinarCore.java
new file mode 100644
index 0000000000000000000000000000000000000000..557dd5fb3228e889ab8f4bc03c7ece05d7ba834f
--- /dev/null
+++ b/src/main/java/net/kissenpvp/base/PulvinarCore.java
@@ -0,0 +1,79 @@
+package net.kissenpvp.base;
+
+import net.kissenpvp.api.base.Pulvinar;
+import net.kissenpvp.api.database.ConnectionProvider;
+import net.kissenpvp.api.network.actor.ConsoleClient;
+import net.kissenpvp.database.InternalConnectionProvider;
+import org.bukkit.Bukkit;
+import org.bukkit.configuration.InvalidConfigurationException;
+import org.jspecify.annotations.NonNull;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import javax.sql.DataSource;
+import java.io.File;
+import java.io.IOException;
+import java.sql.SQLException;
+
+/**
+ * Allows access to the kissen api
+ */
+public class PulvinarCore extends KissenCore implements Pulvinar
+{
+    private static final Logger log = LoggerFactory.getLogger(PulvinarCore.class);
+    private final PulvinarConfig config;
+
+    private final ConnectionProvider provider;
+
+    public PulvinarCore(@NonNull File optionsFile) throws IOException, InvalidConfigurationException, SQLException {
+        config = new PulvinarConfig();
+        config.init(optionsFile);
+
+        if(!config.databaseConfigured())
+        {
+            log.warn("*".repeat(50));
+            log.warn("The database has not yet been configured.");
+            log.warn("Please be sure to set \"database.configured\" to \"true\" after configuring.");
+            log.warn("If you need assistance with setting up the database see https://docs.pulvinar.org/TODO");
+            log.warn("*".repeat(50));
+
+            throw new IllegalStateException("Could not connect to database, please check your configuration.");
+        }
+
+        provider = new InternalConnectionProvider();
+        provider.connect(config.databaseUrl(), config.databaseUser(), config.databasePassword());
+
+        if(provider.dataSource().isEmpty())
+        {
+            throw new SQLException("The providers dataSource is not present. Couldn't it connect?");
+        }
+
+        DataSource dataSource = provider.dataSource().get();
+        createRepositories(dataSource);
+        init();
+    }
+
+    private void createRepositories(DataSource dataSource)
+    {
+
+    }
+
+    public void shutdown()
+    {
+        connectionProvider().disconnect();
+    }
+
+    public @NonNull PulvinarConfig config() {
+        return config;
+    }
+
+    @Override public ConsoleClient console()
+    {
+        return Bukkit.getConsoleSender();
+    }
+
+    @Override
+    public @NonNull ConnectionProvider connectionProvider() {
+        return provider;
+    }
+}
