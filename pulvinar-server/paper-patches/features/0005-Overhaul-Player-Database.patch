@@ -0,0 +1,45 @@
+package net.kissenpvp.network.actor;
+
+import com.destroystokyo.paper.profile.PaperGameProfileRepository;
+import com.mojang.authlib.Environment;
+import com.mojang.authlib.ProfileLookupCallback;
+import net.minecraft.server.players.NameAndId;
+import org.jspecify.annotations.NonNull;
+
+import java.net.Proxy;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.Set;
+
+public class PulvinarProfileRepository extends PaperGameProfileRepository {
+
+    private final PulvinarPlayerRepository repository;
+
+    public PulvinarProfileRepository(Proxy proxy, Environment environment, PulvinarPlayerRepository repository) {
+        super(proxy, environment);
+        this.repository = repository;
+    }
+
+    @Override
+    protected Set<String> databaseLookup(Set<String> unfound, ProfileLookupCallback callback) {
+        Set<String> stillUndiscovered = new HashSet<>(unfound);
+
+        for(NameAndId current : repository.findProfilesByNames(unfound.toArray(new String[0])))
+        {
+            stillUndiscovered.remove(current.name());
+            callback.onProfileLookupSucceeded(current.name(), current.id());
+        }
+
+        return stillUndiscovered;
+    }
+
+    public void generateProfiles(NameAndId... nameAndIds)
+    {
+        repository.generateProfileIfAbsent(nameAndIds).join();
+    }
+
+    public @NonNull Collection<NameAndId> findAllProfiles()
+    {
+        return repository.findAllProfiles().join();
+    }
+}
