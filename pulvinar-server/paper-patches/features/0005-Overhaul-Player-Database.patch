diff --git a/src/main/java/net/kissenpvp/network/actor/PulvinarPlayerRepository.java b/src/main/java/net/kissenpvp/network/actor/PulvinarPlayerRepository.java
new file mode 100644
index 0000000000000000000000000000000000000000..9dda5813fe822b2374ad49cb6afaa963b010b284
--- /dev/null
+++ b/src/main/java/net/kissenpvp/network/actor/PulvinarPlayerRepository.java
@@ -0,0 +1,183 @@
+package net.kissenpvp.network.actor;
+
+import com.google.common.base.Preconditions;
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.base.PulvinarCore;
+import net.kissenpvp.database.AsyncDatabaseQueue;
+import net.minecraft.server.players.NameAndId;
+import org.bukkit.Bukkit;
+import org.jspecify.annotations.NonNull;
+
+import javax.sql.DataSource;
+import javax.sql.rowset.serial.SerialBlob;
+import java.sql.Blob;
+import java.sql.ResultSet;
+import java.util.*;
+import java.util.concurrent.CompletableFuture;
+
+public class PulvinarPlayerRepository extends MariaDBPlayerRepository {
+
+    public PulvinarPlayerRepository(@NonNull DataSource dataSource) throws NullPointerException {
+        super(dataSource);
+    }
+
+    @Override
+    protected @NonNull PlayerClient toCachedEntity(@NonNull UUID uuid, @NonNull ResultSet resultSet) throws NullPointerException {
+        return Bukkit.getOfflinePlayer(uuid);
+    }
+
+    public @NonNull CompletableFuture<Collection<NameAndId>> findAllProfiles()
+    {
+        String sql = "SELECT id, username FROM ksvp_player;";
+        return CompletableFuture.supplyAsync(() -> assumeNotNull(query(sql, (statement) -> {
+            try (ResultSet resultSet = statement.executeQuery()) {
+                Collection<NameAndId> profile = new HashSet<>();
+                while(resultSet.next())
+                {
+                    UUID id = UUID.fromString(resultSet.getString("id"));
+                    String username = resultSet.getString("username");
+
+                    profile.add(new NameAndId(id, username));
+                }
+                return Collections.unmodifiableCollection(profile);
+            }
+        })));
+    }
+
+    public @NonNull Collection<NameAndId> findProfilesByNames(@NonNull String[] names) {
+        Set<NameAndId> discovered = new HashSet<>();
+        Set<String> undiscovered = new HashSet<>(Set.of(names));
+
+        for(PlayerClient cachedPlayerClient : cachedEntries().values())
+        {
+            if(!undiscovered.contains(cachedPlayerClient.username()))
+            {
+                continue;
+            }
+            undiscovered.remove(cachedPlayerClient.username());
+            discovered.add(new NameAndId(cachedPlayerClient.id(), cachedPlayerClient.username()));
+        }
+
+        if(undiscovered.isEmpty())
+        {
+            return discovered;
+        }
+
+        String placeholders = String.join(", ", Collections.nCopies(undiscovered.size(), "?"));
+        String sql = "SELECT id, username FROM ksvp_player WHERE username IN (" + placeholders + ");";
+        query(sql, (statement) -> {
+            int index = 1;
+            for(String argument : undiscovered)
+            {
+                statement.setString(index++, argument);
+            }
+
+            try(ResultSet resultSet = statement.executeQuery())
+            {
+                while(resultSet.next())
+                {
+                    UUID id = UUID.fromString(resultSet.getString("id"));
+                    String username = resultSet.getString("username");
+
+                    discovered.add(new NameAndId(id, username));
+                }
+            }
+
+            return null;
+        });
+
+        return discovered;
+    }
+
+    public @NonNull CompletableFuture<Void> generateProfileIfAbsent(@NonNull NameAndId[] nameAndId)
+    {
+        String globalDatabase = ((PulvinarCore) Bukkit.getPulvinar()).config().databaseGlobal();
+
+        String sql = "INSERT INTO %s.ksvp_identity (link_id) VALUES (?) ON DUPLICATE KEY UPDATE link_id = link_id;";
+        String sql2 = "INSERT INTO %s.ksvp_player (id, link_id, username) VALUES (?, ?, ?) ON DUPLICATE KEY UPDATE id = id, link_id = link_id, username = ?;";
+
+        return CompletableFuture.supplyAsync(() -> {
+            query(String.format(sql, globalDatabase), (statement) -> {
+                for(NameAndId player : nameAndId)
+                {
+                    if(cached(player.id()))
+                    {
+                        continue;
+                    }
+
+                    statement.setString(1, String.valueOf(player.id()));
+                    statement.addBatch();
+                }
+                statement.executeBatch();
+                return null;
+            });
+
+            query(String.format(sql2, globalDatabase), (statement) -> {
+                for(NameAndId player : nameAndId)
+                {
+                    if(cached(player.id()))
+                    {
+                        continue;
+                    }
+
+                    String id = String.valueOf(player.id());
+
+                    statement.setString(1, id);
+                    statement.setString(2, id);
+
+                    statement.setString(3, player.name());
+                    statement.setString(4, player.name());
+                    statement.addBatch();
+                }
+                statement.executeBatch();
+                return null;
+            });
+
+            return null;
+        });
+    }
+
+    /**
+     * Saves a byte array as a blob inside the database.
+     * This is done in the private part of the database.
+     *
+     * @param player the player the properties are attached to
+     * @param data the actual data
+     * @return a completable future when the task is done
+     */
+    public @NonNull CompletableFuture<Void> saveProperties(@NonNull UUID player, byte[] data)
+    {
+        Preconditions.checkNotNull(player);
+
+        String privateDatabase = ((PulvinarCore)PulvinarCore.getInstance()).config().databasePrivate();
+        String sql = "INSERT INTO " + privateDatabase + ".ksvp_player_properties (id, content) VALUES (?, ?) ON DUPLICATE KEY UPDATE content = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> query(sql, statement ->
+        {
+            Blob blob = new SerialBlob(data);
+            statement.setString(1, String.valueOf(player));
+            statement.setBlob(2, blob);
+            statement.setBlob(3, blob);
+            statement.executeUpdate();
+            return null;
+        }));
+    }
+
+    public @NonNull CompletableFuture<Optional<Blob>> findProperties(@NonNull UUID uuid) {
+        Preconditions.checkNotNull(uuid, "The uuid cannot be null!");
+        String privateDatabase = ((PulvinarCore)PulvinarCore.getInstance()).config().databasePrivate();
+
+        String sql = "SELECT content FROM " + privateDatabase + ".ksvp_player_properties WHERE id = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> this.query(sql, (statement) -> {
+            statement.setString(1, String.valueOf(uuid));
+
+            try (ResultSet resultSet = statement.executeQuery()) {
+                if (!resultSet.next())
+                {
+                    return Optional.empty();
+                }
+
+                return Optional.of(resultSet.getBlob("content"));
+            }
+        }));
+    }
+}
