diff --git a/src/main/java/net/kissenpvp/network/actor/whitelist/PulvinarWhiteListRepository.java b/src/main/java/net/kissenpvp/network/actor/whitelist/PulvinarWhiteListRepository.java
new file mode 100644
index 0000000000000000000000000000000000000000..b09d9aefb4a1afe578363a962ce0ec3f35a94376
--- /dev/null
+++ b/src/main/java/net/kissenpvp/network/actor/whitelist/PulvinarWhiteListRepository.java
@@ -0,0 +1,160 @@
+package net.kissenpvp.network.actor.whitelist;
+
+import com.google.common.base.Preconditions;
+import net.kissenpvp.api.database.DeletableRepository;
+import net.kissenpvp.api.database.KissenRepository;
+import net.kissenpvp.base.PulvinarCore;
+import net.kissenpvp.database.AsyncDatabaseQueue;
+import net.minecraft.server.players.NameAndId;
+import net.minecraft.server.players.UserWhiteListEntry;
+import org.bukkit.Bukkit;
+import org.jspecify.annotations.NonNull;
+
+import javax.sql.DataSource;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.*;
+import java.util.concurrent.CompletableFuture;
+
+public class PulvinarWhiteListRepository extends KissenRepository<UUID, PulvinarWhiteListEntry> implements DeletableRepository<UUID> {
+
+    public PulvinarWhiteListRepository(@NonNull DataSource dataSource) throws NullPointerException {
+        super(dataSource);
+    }
+
+    private static @NonNull String globalDatabase() {
+        return ((PulvinarCore) Bukkit.getPulvinar()).config().databaseGlobal();
+    }
+
+    private static @NonNull PulvinarWhiteListEntry toEntity(@NonNull UUID id, @NonNull ResultSet resultSet) throws SQLException {
+        Preconditions.checkNotNull(id, "Id must not be null.");
+        Preconditions.checkNotNull(resultSet, "ResultSet must not be null.");
+
+        String name = resultSet.getString("username");
+        return new UserWhiteListEntry(new NameAndId(id, name));
+    }
+
+    private static @NonNull Collection<PulvinarWhiteListEntry> collectResults(@NonNull ResultSet resultSet) throws SQLException {
+        Preconditions.checkNotNull(resultSet, "ResultSet must not be null.");
+        Collection<PulvinarWhiteListEntry> entries = new HashSet<>();
+
+        while(resultSet.next())
+        {
+            UUID id = UUID.fromString(resultSet.getString("id"));
+            entries.add(toEntity(id, resultSet));
+        }
+        return Collections.unmodifiableCollection(entries);
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Optional<PulvinarWhiteListEntry>> find(@NonNull UUID uuid) throws NullPointerException {
+        String sql = "SELECT p.username AS username FROM ksvp_whitelist w JOIN %s.ksvp_player p ON w.id = p.id WHERE w.id = ?;";
+
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(String.format(sql, globalDatabase()), (statement) -> {
+            statement.setString(1, String.valueOf(uuid));
+            try (ResultSet resultSet = statement.executeQuery()) {
+
+                if(!resultSet.next())
+                {
+                    return Optional.empty();
+                }
+
+                return Optional.of(toEntity(uuid, resultSet));
+            }
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Collection<PulvinarWhiteListEntry>> findAll(@NonNull Iterable<UUID> iterable) throws NullPointerException {
+        int size = computeIterableSize(iterable);
+        if(size == 0)
+        {
+            return CompletableFuture.completedFuture(Collections.emptyList());
+        }
+
+        String placeholders = String.join(", ", Collections.nCopies(size, "?"));
+        String sql = "SELECT w.id, p.username AS username FROM ksvp_whitelist w JOIN %s.ksvp_player p ON w.id = p.id WHERE w.id IN (" + placeholders + ")";
+
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(String.format(sql, globalDatabase()), (statement) ->
+        {
+            int index = 1;
+
+            for (UUID current : iterable) {
+                statement.setString(index++, String.valueOf(current));
+            }
+
+            try (ResultSet resultSet = statement.executeQuery()) {
+                return collectResults(resultSet);
+            }
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Collection<PulvinarWhiteListEntry>> findAll() {
+        String sql = "SELECT w.id, p.username AS username FROM ksvp_whitelist w JOIN %s.ksvp_player p ON w.id = p.id";
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(String.format(sql, globalDatabase()), (statement) -> {
+            try (ResultSet resultSet = statement.executeQuery()) {
+                return collectResults(resultSet);
+            }
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<@NonNull Boolean> has(@NonNull UUID uuid) throws NullPointerException {
+        Preconditions.checkNotNull(uuid, "Uuid must not be null.");
+
+        String sql = "SELECT id FROM ksvp_whitelist WHERE id = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> assumeNotNull(query(sql, (statement) -> {
+            statement.setString(1, String.valueOf(uuid));
+
+            try (ResultSet resultSet = statement.executeQuery()) {
+                return resultSet.next();
+            }
+        })));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<Void> saveAll(@NonNull Iterable<PulvinarWhiteListEntry> iterable) throws NullPointerException {
+        return AsyncDatabaseQueue.submitTask(() -> {
+
+            // as the operators are saved at once, we must clear the list so that removed entries will not remain in the database
+            // operators will likely never exceed a low number in terms of computers, so this does not tank performance all to much
+            //noinspection SqlWithoutWhere
+            query("DELETE FROM ksvp_whitelist;", PreparedStatement::executeUpdate);
+
+            String sql = "INSERT INTO ksvp_whitelist (id) VALUES (?) ON DUPLICATE KEY UPDATE id = ?;";
+            return query(sql, (statement) -> {
+                for(PulvinarWhiteListEntry entry : iterable)
+                {
+                    String uuid = String.valueOf(entry.id());
+                    statement.setString(1, uuid);
+                    statement.setString(2, uuid);
+                    statement.addBatch();
+                }
+
+                statement.executeBatch();
+                return null;
+            });
+        });
+    }
+
+    @Override
+    public @NonNull CompletableFuture<Void> delete(@NonNull UUID uuid) {
+        return deleteAll(Collections.singleton(uuid));
+    }
+
+    @Override
+    public @NonNull CompletableFuture<Void> deleteAll(@NonNull Iterable<UUID> iterable) {
+        String sql = "DELETE FROM ksvp_whitelist WHERE id = ?;";
+        return AsyncDatabaseQueue.submitTask(() -> query(sql, (statement) -> {
+            for(UUID id : iterable)
+            {
+                statement.setString(1, String.valueOf(id));
+                statement.addBatch();
+            }
+            statement.executeBatch();
+            return null;
+        }));
+    }
+}
