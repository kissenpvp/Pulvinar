 public class PulvinarProfileCache extends GameProfileCache
 {
-    public PulvinarProfileCache(@NotNull GameProfileRepository gameProfileRepository)
+    private static final Logger log = LoggerFactory.getLogger(PulvinarProfileCache.class);
+
+    /**
+     * Creates a new {@code PulvinarProfileCache} that manages player profile caching
+     * through the specified {@link GameProfileRepository} without using a cache file.
+     * <p>
+     * This constructor requires that the given repository is an instance of
+     * {@link PaperGameProfileRepository} backed by a {@link PulvinarPlayerRepository}.
+     * In such cases, profiles are stored directly in the database, and no file-based
+     * cache is used.
+     *
+     * @param gameProfileRepository the repository for managing game profiles; must not be {@code null}
+     * @throws IllegalArgumentException if the repository is not a {@code PaperGameProfileRepository}
+     *                                  backed by a {@code PulvinarPlayerRepository}
+     */
+    public PulvinarProfileCache(@NotNull GameProfileRepository gameProfileRepository) {
+        this(gameProfileRepository, null);
+        if (!(gameProfileRepository instanceof PaperGameProfileRepository paper) ||
+            !(paper.playerRepository() instanceof PulvinarPlayerRepository)) {
+            throw new IllegalArgumentException(
+                    "GameProfileRepository must not be an instance of PaperGameProfileRepository when not using a file."
+            );
+        }
+    }
+
+    /**
+     * Creates a new {@code PulvinarProfileCache} that manages player profile caching
+     * through the specified {@link GameProfileRepository}, optionally using a cache file.
+     * <p>
+     * If a {@code file} is provided, profiles may be cached to disk as well as
+     * retrieved from the repository. If {@code file} is {@code null}, database-backed
+     * persistence is expected, in which case the repository must fulfill the same
+     * requirements enforced by the single-argument constructor.
+     *
+     * @param gameProfileRepository the repository for managing game profiles; must not be {@code null}
+     * @param file                  the cache file to use for storing profile data locally, or {@code null}
+     */
+    public PulvinarProfileCache(@NotNull GameProfileRepository gameProfileRepository, File file) {
+        super(gameProfileRepository, file);
+    }
+
+    @Override public void add(@NotNull GameProfile gameProfile)
     {
-        super(gameProfileRepository, null);
+        if(getRepository() instanceof PaperGameProfileRepository paper && paper.playerRepository() instanceof PulvinarPlayerRepository playerRepository)
+        {
+        }
+
+        super.add(gameProfile);
     }
 
     @SuppressWarnings("ClassEscapesDefinedScope") @Override public @NotNull List<GameProfileInfo> load()
@@ -40,11 +80,18 @@ public class PulvinarProfileCache extends GameProfileCache
             }).toList();
         }
 
+
         return super.load();
     }
 
     @Override public void save(boolean asyncSave)
     {
-        // this can be skipped, profiles are automatically saved when they are updated
+        if(getRepository() instanceof PaperGameProfileRepository paper && paper.playerRepository() instanceof PulvinarPlayerRepository)
+        {
+            // this can be skipped, profiles are automatically saved when they are updated
+            return;
+        }
+
+        super.save(asyncSave);
     }
 }
