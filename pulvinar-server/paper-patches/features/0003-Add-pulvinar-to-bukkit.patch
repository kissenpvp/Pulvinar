+package net.kissenpvp.punishment;
+
+import com.mojang.authlib.GameProfile;
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.api.punishment.PunishmentSubscription;
+import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
+import net.minecraft.server.players.UserBanListEntry;
+import org.jetbrains.annotations.Contract;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Date;
+import java.util.Objects;
+
+public class PunishmentEntry extends UserBanListEntry
+{
+    private static final Logger log = LoggerFactory.getLogger(PunishmentEntry.class);
+    private PunishmentSubscription punishment;
+
+    @Contract(value = "_ -> new", pure = true)
+    public static @NotNull PunishmentEntry from(@NotNull PunishmentSubscription subscription)
+    {
+        return new PunishmentEntry(subscription);
+    }
+
+    private PunishmentEntry(@NotNull PunishmentSubscription punishment)
+    {
+        super((GameProfile) null);
+        this.punishment = punishment;
+    }
+
+    @Override public @NotNull Date getCreated()
+    {
+        return Date.from(getPunishment().temporal().start());
+    }
+
+    @Override public @NotNull String getSource()
+    {
+        return getPunishment().operator().username();
+    }
+
+    @Override public @Nullable Date getExpires()
+    {
+        // convert expiry from instant to date if exists. If it doesn't exist, return null'
+        // null means a permanent ban.
+        return getPunishment().temporal().expiry().map(Date::from).orElse(null);
+    }
+
+    @Override public @NotNull String getReason()
+    {
+        PlainTextComponentSerializer serializer = PlainTextComponentSerializer.plainText();
+        return getPunishment().message().map(serializer::serialize).orElse("Banned by an operator.");
+    }
+
+    @Override public @Nullable GameProfile getUser() throws IllegalStateException
+    {
+        PlayerClient playerClient = getPunishment().target();
+        return new GameProfile(playerClient.id(), playerClient.username());
+    }
+
+    public @NotNull PunishmentSubscription getPunishment()
+    {
+        return punishment;
+    }
+
+    public void update(@NotNull PunishmentSubscription subscription)
+    {
+        if(!Objects.equals(subscription, punishment))
+        {
+            throw new IllegalArgumentException("Updated subscription must be the same as the original.");
+        }
+
+        if(Objects.equals(subscription.signature(), punishment.signature()))
+        {
+            log.warn("Updated subscription {} has the same signature as the original. Skipping update.", subscription);
+            return;
+        }
+
+        punishment = subscription;
+    }
+}
