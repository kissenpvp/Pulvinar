@@ -0,0 +1,31 @@
+package net.kissenpvp.network.actor.operator;
+
+import com.mojang.authlib.GameProfile;
+import net.kissenpvp.api.network.actor.OperatorInfo;
+import net.kissenpvp.network.actor.InternalOperatorRepository;
+import net.minecraft.server.players.ServerOpListEntry;
+import org.jetbrains.annotations.NotNull;
+
+import javax.sql.DataSource;
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.UUID;
+
+public class PulvinarOperatorRepository extends InternalOperatorRepository
+{
+    public PulvinarOperatorRepository(@NotNull DataSource dataSource) throws NullPointerException
+    {
+        super(dataSource);
+    }
+
+    @Override
+    public @NotNull OperatorInfo toEntity(@NotNull UUID uuid, @NotNull ResultSet resultSet) throws SQLException, NullPointerException
+    {
+        GameProfile profile = new GameProfile(uuid, resultSet.getString("username"));
+        int level = resultSet.getInt("operator_level");
+        boolean canBypass = resultSet.getBoolean("can_bypass_player_limit");
+
+        return new ServerOpListEntry(profile, level, canBypass);
+    }
+}
