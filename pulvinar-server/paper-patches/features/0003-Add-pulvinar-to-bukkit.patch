@@ -0,0 +1,130 @@
+package net.kissenpvp.punishment;
+
+import com.mojang.authlib.GameProfile;
+import net.kissenpvp.api.database.RepositoryHolder;
+import net.kissenpvp.api.network.actor.PlayerClient;
+import net.kissenpvp.api.punishment.Punishment;
+import net.kissenpvp.api.punishment.PunishmentSubscription;
+import net.kissenpvp.api.punishment.PunishmentSubscriptionRepository;
+import net.kissenpvp.api.punishment.PunishmentType;
+import net.kissenpvp.api.temporal.WritableTemporalObject;
+import net.kissenpvp.temporal.InternalWritableTemporalObject;
+import net.kissenpvp.temporal.timespan.PermanentTimeSpan;
+import net.kyori.adventure.text.Component;
+import net.minecraft.server.players.UserBanList;
+import net.minecraft.server.players.UserBanListEntry;
+import org.bukkit.Bukkit;
+import org.jetbrains.annotations.Contract;
+import org.jetbrains.annotations.NotNull;
+import org.jspecify.annotations.NonNull;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.util.*;
+import java.util.stream.Collector;
+import java.util.stream.Collectors;
+
+public class PunishmentList extends UserBanList
+{
+    private static final Logger log = LoggerFactory.getLogger(PunishmentList.class);
+    private final PunishmentSubscriptionRepository repository;
+
+    @Contract("_ -> new") private static @NotNull PunishmentSubscription convertLegacy(@NotNull UserBanListEntry entry)
+    {
+        if (Objects.isNull(entry.getUser()))
+        {
+            throw new IllegalArgumentException("Cannot create punishment entry from null user.");
+        }
+
+        UUID linkId = Bukkit.getOfflinePlayer(entry.getUser().getId()).linkId();
+        UUID operator = null; // TODO: determine source by the stupid vanilla string
+        WritableTemporalObject temporalObject = InternalWritableTemporalObject.toTemporal(new PermanentTimeSpan());
+
+        if (!((RepositoryHolder) Bukkit.getPulvinar()).punishmentRepository().has(-1).join())
+        {
+            //TODO prohibit creation of negative id's as they are reserved for internal use.
+            Punishment punishment = new InternalPunishment(-1, PunishmentType.BAN, new PermanentTimeSpan());
+            ((RepositoryHolder) Bukkit.getPulvinar()).punishmentRepository().save(punishment).join();
+        }
+
+        return new InternalPunishmentSubscription(-1, linkId, operator, temporalObject, Component.text(entry.getReason()));
+    }
+
+    public PunishmentList(@NotNull PunishmentSubscriptionRepository repository)
+    {
+        //noinspection DataFlowIssue we're not using files anymore. We're beyond that
+        super(null);
+        this.repository = repository;
+    }
+
+    @Override public void add(@NotNull UserBanListEntry entry)
+    {
+        GameProfile profile = entry.getUser(); assert profile != null;
+
+        if (entry instanceof PunishmentEntry punishmentEntry)
+        {
+            getMap().put(this.getKeyForUser(profile), entry);
+            getRepository().save(punishmentEntry.getPunishment()).join();
+            return;
+        }
+
+        log.warn("Received legacy ban entry {}. Converting to PunishmentEntry...", entry);
+        PunishmentEntry punishmentEntry = PunishmentEntry.from(convertLegacy(entry));
+
+        // will never end up in a recursion loop as we are passing a punishment entry.
+        add(punishmentEntry);
+    }
+
+    @Override public void save() throws IOException
+    {
+        // saving is handled by the repository
+    }
+
+    @Override public void remove(@NotNull GameProfile user)
+    {
+        UserBanListEntry entry = getMap().remove(getKeyForUser(user));
+        if(entry instanceof PunishmentEntry punishmentEntry)
+        {
+            PunishmentSubscription subscription = punishmentEntry.getPunishment();
+            subscription.temporal().expire();
+            getRepository().save(subscription).join();
+        }
+    }
+
+    @Override public void load() throws IOException
+    {
+        Collection<PunishmentSubscription> subscriptions = repository.findAll().join();
+        for (PunishmentSubscription subscription : subscriptions)
+        {
+            PlayerClient playerClient = subscription.target();
+            GameProfile gameProfile = new GameProfile(playerClient.id(), playerClient.username());
+            if(!subscription.temporal().expired())
+            {
+                getMap().put(getKeyForUser(gameProfile), PunishmentEntry.from(subscription));
+            }
+        }
+    }
+
+    /**
+     * Creates a collector that processes {@link PunishmentSubscription} objects by expiring their temporal context
+     * and maps them by their unique identifiers.
+     *
+     * @return a collector that collects {@link PunishmentSubscription} objects into a {@link Map}, where the keys
+     * are the identifiers of the subscriptions, and the values are the subscriptions themselves with their
+     * temporal context expired.
+     */
+    private static @NonNull Collector<PunishmentSubscription, ?, Map<String, PunishmentSubscription>> expire()
+    {
+        return Collectors.toMap(PunishmentSubscription::id, punishment ->
+        {
+            punishment.temporal().expire();
+            return punishment;
+        });
+    }
+
+    protected PunishmentSubscriptionRepository getRepository()
+    {
+        return repository;
+    }
+}
