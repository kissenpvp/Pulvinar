+import org.jetbrains.annotations.Nullable;
+
+import java.time.Instant;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.UUID;
+
+public class PlayerMock extends InternalPlayerClient
+{
+    private final UUID id;
+    private final String username;
+
+    public static @NotNull PlayerMock of(@NotNull GameProfile gameProfile)
+    {
+        Objects.requireNonNull(gameProfile, "GameProfile cannot be null");
+        return new PlayerMock(gameProfile.getId(), gameProfile.getName());
+    }
+
+    private PlayerMock(@NotNull UUID id, @NotNull String username)
+    {
+        super(id);
+        this.id = id;
+        this.username = username;
+    }
+
+    @Override public @NotNull UUID getUniqueId()
+    {
+        return id;
+    }
+
+    @Override public long getLastLogin()
+    {
+        return Instant.now().getEpochSecond();
+    }
+
+    @Override public @NotNull DefinedTimeSpan timePlayed()
+    {
+        return new InternalDefinedTimeSpan(0L);
+    }
+
+    @Override public @NotNull PunishmentSubscription punish(@NotNull Punishment punishment) throws NullPointerException
+    {
+        return punish(punishment, null);
+    }
+
+    @Override
+    public @NotNull PunishmentSubscription punish(@NotNull Punishment punishment, @Nullable Component component) throws NullPointerException
+    {
+        throw new UnsupportedOperationException("Cannot punish a player mock.");
+    }
+
+    @Override public @NotNull String username()
+    {
+        return username;
+    }
+
+    @Override public @NotNull Locale locale()
+    {
+        return Locale.US;
+    }
+
+    @Override public boolean isOp()
+    {
+        return false;
+    }
+}
