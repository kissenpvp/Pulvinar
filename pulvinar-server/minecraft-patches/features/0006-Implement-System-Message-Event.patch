From: Ivo Quiring <falk.quiring@gmail.com>
Date: Sun, 8 Mar 2026 00:37:20 +0100
Subject: [PATCH] Implement System-Message Event


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 1a6da393cf83c86d24085ecf6aa4c523fde1c3b7..69d2ebfcf11fcbfaf8bd0cb3a378e802edd51ddd 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -2439,14 +2439,24 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
 
     public void sendSystemMessage(Component message, boolean overlay) {
         if (this.acceptsSystemMessages(overlay)) {
+
+            // Pulvinar start - implement system message event
+            net.kyori.adventure.text.Component adventure = io.papermc.paper.adventure.PaperAdventure.asAdventure(message);
+            net.kissenpvp.api.event.SystemMessageEvent messageEvent = new net.kissenpvp.api.event.SystemMessageEvent(adventure);
+            org.bukkit.Bukkit.getPluginManager().callEvent(messageEvent);
+
+            if(messageEvent.isCancelled()) { return; }
+            Component outputMessage = io.papermc.paper.adventure.PaperAdventure.asVanilla(messageEvent.getMessage());
+            // Pulvinar end - implement system message event
+
             this.connection
                 .send(
-                    new ClientboundSystemChatPacket(message, overlay),
+                    new ClientboundSystemChatPacket(/*message*/ outputMessage, overlay), // Pulvinar - implement system message event
                     PacketSendListener.exceptionallySend(
                         () -> {
                             if (this.acceptsSystemMessages(false)) {
                                 int i = 256;
-                                String string = message.getString(256);
+                                String string = /*message*/outputMessage.getString(256); // Pulvinar - implement system message event
                                 Component component = Component.literal(string).withStyle(ChatFormatting.YELLOW);
                                 return new ClientboundSystemChatPacket(
                                     Component.translatable("multiplayer.message_not_delivered", component).withStyle(ChatFormatting.RED), false
