@@ -132,4 +132,11 @@ public abstract class StoredUserList<K, V extends StoredUserEntry<K>> {
             // Spigot end
         }
     }
+
+    // Pulvinar start - allow protected access to map
+    protected Map<String, V> getMap()
+    {
+        return map;
+    }
+    // Pulvinar end - allow protected access to map
 }
