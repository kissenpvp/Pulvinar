From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Quiring <falk.quiring@gmail.com>
Date: Wed, 20 Aug 2025 11:31:51 +0200
Subject: [PATCH] Add pulvinar instance


diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index b06c2c4aa77edafb374f7cf0406cf4d29c6e7f9f..c067fc09a86190da797eeafa858ecb632975fc0b 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -175,6 +175,13 @@ public class Main {
 
             org.spigotmc.SpigotConfig.disabledAdvancements = spigotConfiguration.getStringList("advancements.disabled"); // Paper - fix SPIGOT-5885, must be set early in init
 
+            // Pulvinar start - hook in kissen
+            LOGGER.info("Pulvinar is now going to hook in pulvinar.");
+            java.io.File pulvinarSettings = (java.io.File) optionSet.valueOf("pulvinar-settings");
+            net.kissenpvp.base.Pulvinar pulvinar = new net.kissenpvp.base.PulvinarCore(pulvinarSettings);
+            org.bukkit.Bukkit.setPulvinar(pulvinar);
+            // Pulvinar end - hook in kissen
+
             // Paper start - fix SPIGOT-5824
             File file;
             File userCacheFile = new File(Services.USERID_CACHE_FILE);
diff --git a/net/minecraft/server/Services.java b/net/minecraft/server/Services.java
index 015e3ff8d856a7722def4448d8c68792cc3a32a2..6ab9257e581fdd10872c8be2fd5317d9606b0a78 100644
--- a/net/minecraft/server/Services.java
+++ b/net/minecraft/server/Services.java
@@ -29,7 +29,7 @@ public record Services(
     public static Services create(YggdrasilAuthenticationService authenticationService, File profileRepository, File userCacheFile, joptsimple.OptionSet optionSet) throws Exception { // Paper - add optionset to load paper config files; add userCacheFile parameter
         MinecraftSessionService minecraftSessionService = authenticationService.createMinecraftSessionService();
         GameProfileRepository gameProfileRepository = authenticationService.createProfileRepository();
-        GameProfileCache gameProfileCache = new GameProfileCache(gameProfileRepository, userCacheFile); // Paper - use specified user cache file
+        GameProfileCache gameProfileCache = new net.kissenpvp.network.actor.PulvinarProfileCache(gameProfileRepository); // new GameProfileCache(gameProfileRepository, userCacheFile); // Paper - use specified user cache file // Pulvinar - delegate caching to database
         // Paper start - load paper config files from cli options
         final java.nio.file.Path legacyConfigPath = ((File) optionSet.valueOf("paper-settings")).toPath();
         final java.nio.file.Path configDirPath = ((File) optionSet.valueOf("paper-settings-directory")).toPath();
diff --git a/net/minecraft/server/players/GameProfileCache.java b/net/minecraft/server/players/GameProfileCache.java
index 066f84df5c31242ab542932f1e243369d0e766e2..a34b21bccb123525806f1ff6f7230d93da2a5b2b 100644
--- a/net/minecraft/server/players/GameProfileCache.java
+++ b/net/minecraft/server/players/GameProfileCache.java
@@ -317,12 +317,12 @@ public class GameProfileCache {
         }
     }
 
-    static class GameProfileInfo {
+    protected static class GameProfileInfo { // Pulvinar - allow protected access
         private final GameProfile profile;
         final Date expirationDate;
         private volatile long lastAccess;
 
-        GameProfileInfo(GameProfile profile, Date expirationDate) {
+        public GameProfileInfo(GameProfile profile, Date expirationDate) {  // Pulvinar - allow public access
             this.profile = profile;
             this.expirationDate = expirationDate;
         }
@@ -343,4 +343,19 @@ public class GameProfileCache {
             return this.lastAccess;
         }
     }
+
+    // Pulvinar start - allow protected access to the profile repository and executor
+    protected Map<String, CompletableFuture<Optional<GameProfile>>> getRequests()
+    {
+        return requests;
+    }
+
+    protected @Nullable Executor getExecutor() {
+        return this.executor;
+    }
+
+    protected GameProfileRepository getRepository() {
+        return this.profileRepository;
+    }
+    // Pulvinar end - allow protected access to the profile repository and executor
 }
diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index db56578bff06574337463c2421537f43d1a19189..b9820f72b08d6fad9739bdd9cdecc5d0c3e64277 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -115,7 +115,7 @@ public abstract class PlayerList {
     private final Map<UUID, ServerPlayer> playersByUUID = Maps.newHashMap();
     private final UserBanList bans = new UserBanList(USERBANLIST_FILE);
     private final IpBanList ipBans = new IpBanList(IPBANLIST_FILE);
-    private final ServerOpList ops = new ServerOpList(OPLIST_FILE);
+    private final ServerOpList ops = new net.kissenpvp.network.actor.operator.PulvinarOperatorList(org.bukkit.Bukkit.getPulvinar().playerModule().operatorRepository()); // new ServerOpList(OPLIST_FILE); // Pulvinar - migrate operator data to database
     private final UserWhiteList whitelist = new UserWhiteList(WHITELIST_FILE);
     // CraftBukkit start
     // private final Map<UUID, ServerStatsCounter> stats = Maps.newHashMap();
diff --git a/net/minecraft/server/players/ServerOpListEntry.java b/net/minecraft/server/players/ServerOpListEntry.java
index aa2663be118b628257e16e3da309e8a3b4f9ad71..f01f19d97161ad109aaa06c9d52e7fe23f6b83c3 100644
--- a/net/minecraft/server/players/ServerOpListEntry.java
+++ b/net/minecraft/server/players/ServerOpListEntry.java
@@ -2,10 +2,12 @@ package net.minecraft.server.players;
 
 import com.google.gson.JsonObject;
 import com.mojang.authlib.GameProfile;
+import org.jetbrains.annotations.NotNull;
+
 import java.util.UUID;
 import javax.annotation.Nullable;
 
-public class ServerOpListEntry extends StoredUserEntry<GameProfile> {
+public class ServerOpListEntry extends StoredUserEntry<GameProfile> implements net.kissenpvp.api.network.actor.OperatorInfo { // Pulvinar start - migrate operator data to database
     private final int level;
     private final boolean bypassesPlayerLimit;
 
@@ -56,4 +58,36 @@ public class ServerOpListEntry extends StoredUserEntry<GameProfile> {
             return null;
         }
     }
+
+    // Pulvinar start - migrate operator data to database
+    @Override public UUID id()
+    {
+        if(java.util.Objects.isNull(getUser()))
+        {
+            throw new java.lang.IllegalStateException("User is null");
+        }
+
+        return getUser().getId();
+    }
+
+    @Override public String name()
+    {
+        if(java.util.Objects.isNull(getUser()))
+        {
+            throw new java.lang.IllegalStateException("User is null");
+        }
+
+        return getUser().getName();
+    }
+
+    @Override public int signature()
+    {
+        return java.util.Objects.hash(id(), level, bypassesPlayerLimit);
+    }
+
+    @Override public boolean unsaved()
+    {
+        return false;
+    }
+    // Pulvinar end - migrate operator data to database
 }
