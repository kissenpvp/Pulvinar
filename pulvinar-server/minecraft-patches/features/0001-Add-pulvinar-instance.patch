+    // Pulvinar start - use database ban system instead of vanilla
+    private static net.kissenpvp.punishment.PunishmentEntry createEntry(CommandSourceStack source, NameAndId gameProfile, @Nullable Component reason)
+    {
+        net.kissenpvp.api.temporal.timespan.TimeSpan temporal = new net.kissenpvp.temporal.timespan.PermanentTimeSpan();
+        net.kissenpvp.temporal.InternalWritableTemporalObject permanent = net.kissenpvp.temporal.InternalWritableTemporalObject.toTemporal(temporal);
+        net.kyori.adventure.text.Component component = null;
+        if (java.util.Objects.nonNull(reason))
+        {
+            component = net.kyori.adventure.text.Component.text(reason.getString());
+        }
+
+        java.util.UUID sourceUuid = null;
+        if(source.isPlayer())
+        {
+            sourceUuid = java.util.Objects.requireNonNull(source.getPlayer()).getUUID();
+        }
+
+        // Look - I know this is stupid and I promise I will come back later for this...
+        java.util.UUID linkId = org.bukkit.Bukkit.getOfflinePlayer(gameProfile.id()).linkId();
+
+        return net.kissenpvp.punishment.PunishmentEntry.from(new net.kissenpvp.punishment.InternalPunishmentSubscription(
+                -1,
+                linkId,
+                sourceUuid,
+                permanent,
+                component
+        ));
+    }
+    // Pulvinar end - use database ban system instead of vanilla
 }
