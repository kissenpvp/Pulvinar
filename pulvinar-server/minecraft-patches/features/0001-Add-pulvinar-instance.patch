diff --git a/net/minecraft/server/commands/BanPlayerCommands.java b/net/minecraft/server/commands/BanPlayerCommands.java
index ac3ba9d0ea344fa189912d359b718fbe05e7aa49..cc5b362d661e887911dbcf69d082b9b6cef9c3bd 100644
--- a/net/minecraft/server/commands/BanPlayerCommands.java
+++ b/net/minecraft/server/commands/BanPlayerCommands.java
@@ -47,9 +47,11 @@ public class BanPlayerCommands {
 
         for (GameProfile gameProfile : gameProfiles) {
             if (!bans.isBanned(gameProfile)) {
-                UserBanListEntry userBanListEntry = new UserBanListEntry(
+                // Pulvinar start - use database ban system instead of vanilla
+                UserBanListEntry userBanListEntry = createEntry(source, gameProfile, reason); /*new UserBanListEntry(
                     gameProfile, null, source.getTextName(), null, reason == null ? null : reason.getString()
-                );
+                );*/
+                // Pulvinar end - use database ban system instead of vanilla
                 bans.add(userBanListEntry);
                 i++;
                 source.sendSuccess(
@@ -68,4 +70,34 @@ public class BanPlayerCommands {
             return i;
         }
     }
+
+    // Pulvinar start - use database ban system instead of vanilla
+    private static net.kissenpvp.punishment.PunishmentEntry createEntry(CommandSourceStack source, GameProfile gameProfile, @Nullable Component reason)
+    {
+        net.kissenpvp.api.temporal.timespan.TimeSpan temporal = new net.kissenpvp.temporal.timespan.PermanentTimeSpan();
+        net.kissenpvp.temporal.InternalWritableTemporalObject permanent = net.kissenpvp.temporal.InternalWritableTemporalObject.toTemporal(temporal);
+        net.kyori.adventure.text.Component component = null;
+        if (java.util.Objects.nonNull(reason))
+        {
+            component = net.kyori.adventure.text.Component.text(reason.getString());
+        }
+
+        java.util.UUID sourceUuid = null;
+        if(source.isPlayer())
+        {
+            sourceUuid = java.util.Objects.requireNonNull(source.getPlayer()).getUUID();
+        }
+
+        // Look - I know this is stupid and I promise I will come back later for this...
+        java.util.UUID linkId = org.bukkit.Bukkit.getOfflinePlayer(gameProfile.getId()).linkId();
+
+        return net.kissenpvp.punishment.PunishmentEntry.from(new net.kissenpvp.punishment.InternalPunishmentSubscription(
+                -1,
+                linkId,
+                sourceUuid,
+                permanent,
+                component
+        ));
+    }
+    // Pulvinar end - use database ban system instead of vanilla
 }
