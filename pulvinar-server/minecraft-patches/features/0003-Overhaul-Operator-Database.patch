From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ivo Quiring <falk.quiring@gmail.com>
Date: Sun, 2 Nov 2025 15:56:26 +0100
Subject: [PATCH] Overhaul Operator Database


diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index 1328cc6402134042d5890bedaaacf6e9807eb5ec..fb4f23bc91ab8c828b4d6e38aeeaf1c99b2b3923 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -19,6 +19,8 @@ import java.util.UUID;
 import java.util.function.Function;
 import java.util.function.Predicate;
 import javax.annotation.Nullable;
+
+import net.kissenpvp.api.database.RepositoryHolder;
 import net.minecraft.ChatFormatting;
 import net.minecraft.FileUtil;
 import net.minecraft.commands.CommandSourceStack;
@@ -142,7 +144,7 @@ public abstract class PlayerList {
         this.registries = registries;
         this.playerIo = playerIo;
         this.whitelist = new UserWhiteList(WHITELIST_FILE, notificationService);
-        this.ops = new ServerOpList(OPLIST_FILE, notificationService);
+        this.ops = new net.kissenpvp.network.actor.operator.PulvinarOperatorList(((RepositoryHolder) org.bukkit.Bukkit.getPulvinar()).operatorRepository(), notificationService); // new ServerOpList(OPLIST_FILE, notificationService); // Pulvinar - overhaul operator database
         this.bans = new UserBanList(USERBANLIST_FILE, notificationService);
         this.ipBans = new IpBanList(IPBANLIST_FILE, notificationService);
     }
diff --git a/net/minecraft/server/players/ServerOpListEntry.java b/net/minecraft/server/players/ServerOpListEntry.java
index 2013f5c2fd114819258cb34199665e6632efcdf9..71259a981ca8b1975fea023e64043ac08ef05e0d 100644
--- a/net/minecraft/server/players/ServerOpListEntry.java
+++ b/net/minecraft/server/players/ServerOpListEntry.java
@@ -2,7 +2,7 @@ package net.minecraft.server.players;
 
 import com.google.gson.JsonObject;
 
-public class ServerOpListEntry extends StoredUserEntry<NameAndId> {
+public class ServerOpListEntry extends StoredUserEntry<NameAndId> implements net.kissenpvp.api.network.actor.OperatorInfo { // Pulvinar - overhaul operator database
     private final int level;
     private final boolean bypassesPlayerLimit;
 
@@ -34,4 +34,40 @@ public class ServerOpListEntry extends StoredUserEntry<NameAndId> {
             data.addProperty("bypassesPlayerLimit", this.bypassesPlayerLimit);
         }
     }
+
+    // Pulvinar start - overhaul operator database
+    @Override
+    public String name() {
+        com.google.common.base.Preconditions.checkNotNull(getUser());
+        return getUser().name();
+    }
+
+    @Override
+    public java.util.UUID id() {
+        com.google.common.base.Preconditions.checkNotNull(getUser());
+        return getUser().id();
+    }
+
+    @Override
+    public int signature() {
+        return java.util.Objects.hash(id(), name(), level, bypassesPlayerLimit);
+    }
+
+    @Override
+    public boolean unsaved() {
+        return false;
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (o == null || getClass() != o.getClass()) return false;
+        ServerOpListEntry that = (ServerOpListEntry) o;
+        return id() == that.id();
+    }
+
+    @Override
+    public int hashCode() {
+        return java.util.Objects.hashCode(level);
+    }
+    // Pulvinar end - overhaul operator database
 }
