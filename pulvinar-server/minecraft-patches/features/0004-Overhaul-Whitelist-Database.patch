Subject: [PATCH] Overhaul Whitelist Database


diff --git a/net/minecraft/server/players/PlayerList.java b/net/minecraft/server/players/PlayerList.java
index fcaf3663309c5d1fa67480fed5707e1772945ce3..277763aa3514dbdd8ca03742c13fb4ad06f80200 100644
--- a/net/minecraft/server/players/PlayerList.java
+++ b/net/minecraft/server/players/PlayerList.java
@@ -148,7 +148,7 @@ public abstract class PlayerList {
         this.server = server;
         this.registries = registries;
         this.playerIo = playerIo;
-        this.whitelist = new UserWhiteList(WHITELIST_FILE, notificationService);
+        this.whitelist = new net.kissenpvp.network.actor.whitelist.PulvinarWhiteList(WHITELIST_FILE,  ((net.kissenpvp.base.PulvinarCore) org.bukkit.Bukkit.getPulvinar()).whiteListRepository(), notificationService); // new UserWhiteList(WHITELIST_FILE, notificationService); // Pulvinar - overhaul whitelist database
         this.ops = new net.kissenpvp.network.actor.operator.PulvinarOperatorList(OPLIST_FILE, ((net.kissenpvp.base.PulvinarCore) org.bukkit.Bukkit.getPulvinar()).operatorRepository(), notificationService); // new ServerOpList(OPLIST_FILE, notificationService); // Pulvinar - overhaul operator database
         this.bans = new UserBanList(USERBANLIST_FILE, notificationService);
         this.ipBans = new IpBanList(IPBANLIST_FILE, notificationService);
diff --git a/net/minecraft/server/players/UserWhiteListEntry.java b/net/minecraft/server/players/UserWhiteListEntry.java
index 87041546a5ad36c4b6aafbf2826873df41eb16e8..8e85f3404bf32a7c459227815760512e68b6956a 100644
--- a/net/minecraft/server/players/UserWhiteListEntry.java
+++ b/net/minecraft/server/players/UserWhiteListEntry.java
@@ -2,7 +2,7 @@ package net.minecraft.server.players;
 
 import com.google.gson.JsonObject;
 
-public class UserWhiteListEntry extends StoredUserEntry<NameAndId> {
+public class UserWhiteListEntry extends StoredUserEntry<NameAndId> implements net.kissenpvp.network.actor.whitelist.PulvinarWhiteListEntry { // Pulvinar - Overhaul Whitelist Database
     public UserWhiteListEntry(final NameAndId user) {
         super(user);
     }
@@ -17,4 +17,13 @@ public class UserWhiteListEntry extends StoredUserEntry<NameAndId> {
             this.getUser().appendTo(object);
         }
     }
+
+    // Pulvinar start - overhaul whitelist database
+    @Override
+    public java.util.UUID id() {
+        com.google.common.base.Preconditions.checkNotNull(getUser(), "User must not be null.");
+
+        return getUser().id();
+    }
+    // Pulvinar end - overhaul whitelist database
 }
